# Optional. Without any key the app runs fully, using browser speech recognition and keyword matching
# (the UI labels these as "Browser speech recognition" / "Keyword match (no AI key)").
# Set ONE key to turn on server speech-to-text (Urdu), job understanding, photo hints and name extraction.

# Groq (free tier): Whisper large-v3 for speech, Llama 3.3 70B for text, Llama 4 Scout for photos
GROQ_API_KEY=

# OpenAI: whisper-1, gpt-4o-mini, and tts-1 for spoken guidance
OPENAI_API_KEY=

# Google Gemini: gemini-2.5-flash for audio, text and images
GEMINI_API_KEY=

# If more than one key is set, choose: groq | openai | gemini
AI_PROVIDER=

# Optional model overrides
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_LLM_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash

# Where the SQLite file and uploads are stored (default ./data)
# RR_DATA_DIR=./data
